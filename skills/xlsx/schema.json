{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xlsx skill spec",
  "type": "object",
  "required": ["sheets"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "maxLength": 200},
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/sheet"}
    }
  },
  "$defs": {
    "sheet": {
      "type": "object",
      "required": ["name", "columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 31, "pattern": "^[^\\\\/?*\\[\\]:]+$"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
        },
        "number_formats": {"type": "object", "additionalProperties": {"type": "string"}},
        "totals_row": {"type": "boolean"},
        "chart": {
          "type": "object",
          "required": ["type", "category_column", "value_columns"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["bar", "line", "pie"]},
            "title": {"type": "string", "maxLength": 120},
            "category_column": {"type": "string"},
            "value_columns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
