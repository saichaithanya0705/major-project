{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pptx skill spec",
  "type": "object",
  "required": ["title", "slides"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_color": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
        "font": {"type": "string", "maxLength": 60}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "bullet": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "level": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heading": {"type": "string"},
        "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}}
      }
    },
    "slide": {
      "type": "object",
      "required": ["layout", "title"],
      "additionalProperties": false,
      "properties": {
        "layout": {"enum": ["title", "bullets", "two_column", "table", "image", "section"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "subtitle": {"type": "string", "maxLength": 300},
        "bullets": {"type": "array", "items": {"$ref": "#/$defs/bullet"}},
        "left": {"$ref": "#/$defs/column"},
        "right": {"$ref": "#/$defs/column"},
        "table": {
          "type": "object",
          "required": ["columns", "rows"],
          "additionalProperties": false,
          "properties": {
            "columns": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}},
            "rows": {
              "type": "array",
              "maxItems": 30,
              "items": {"type": "array", "items": {"type": ["string", "number", "null"]}}
            }
          }
        },
        "image_path": {"type": "string"},
        "caption": {"type": "string", "maxLength": 300},
        "notes": {"type": "string", "maxLength": 4000}
      }
    }
  }
}
